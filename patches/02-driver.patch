+#ifndef CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK
+static void ksu_handle_sys_read_fd(unsigned int fd)
+{
+    struct file *file = fget(fd);
+    if (!file) {
+        return;
+    }
+
+    ksu_handle_initrc(file);
+
+    fput(file);
+}
+#endif
